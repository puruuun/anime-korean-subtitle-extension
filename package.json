{
  "name": "anime-korean-subtitle",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/browser-test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:browser:auto": "node scripts/browser-auto-lifecycle.mjs",
    "test:browser:dual": "node scripts/browser-dual-subtitles.mjs",
    "test:browser:settings": "node scripts/browser-settings-updates.mjs",
    "test:browser:progressive": "node scripts/browser-progressive.mjs",
    "test:browser:anissia": "node scripts/browser-anissia-live.mjs",
    "test:anissia:distribution": "node scripts/verify-anissia-distribution.mjs",
    "test:browser:distribution": "node scripts/browser-anissia-distribution.mjs",
    "build:personal": "ANIMESUB_BUILD_TARGET=personal npm run build",
    "build:public": "ANIMESUB_BUILD_TARGET=public npm run build"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "playwright": "1.62.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
