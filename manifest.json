{
  "manifest_version": 3,
  "name": "Anime Korean Subtitle",
  "description": "Miruro / Re:ANIME 외부 자막 검색 및 텍스트 기반 한국어 번역",
  "version": "0.4.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "scripting", "activeTab", "webNavigation"],
  "host_permissions": [
    "https://*.miruro.to/*",
    "https://reanime.to/*",
    "https://api.anissia.net/*",
    "https://graphql.anilist.co/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://jimaku.cc/*",
    "https://subtitles.ajatt.top/*",
    "https://raw.githubusercontent.com/Ajatt-Tools/kitsunekko-mirror/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "한국어 자막"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://*.miruro.to/*", "https://reanime.to/*"],
      "js": ["pageBridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["https://*.miruro.to/*", "https://reanime.to/*"],
      "js": ["contentScript.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
