{
  "manifest_version": 3,
  "name": "Web Video Subtitle",
  "description": "외부 자막 검색·점진적 AI 번역·원문 동시 자막을 지원하는 범용 웹 비디오 자막 확장프로그램",
  "version": "0.5.7",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.miruro.to/*",
    "https://reanime.to/*",
    "https://*.reanime.cz/*",
    "https://api.anissia.net/*",
    "https://graphql.anilist.co/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://jimaku.cc/*",
    "https://subtitles.ajatt.top/*",
    "https://raw.githubusercontent.com/Ajatt-Tools/kitsunekko-mirror/*",
    "https://generativelanguage.googleapis.com/*",
    "https://miruro.to/*",
    "https://www.miruro.to/*",
    "https://flixcloud.cc/*",
    "https://strm.cx/*",
    "https://*.blogspot.com/*",
    "https://*.tistory.com/*",
    "https://blog.kakaocdn.net/*",
    "https://*.naver.com/*",
    "https://*.naver.net/*",
    "https://*.pstatic.net/*",
    "https://www.wikidata.org/*",
    "https://customsearch.googleapis.com/*",
    "https://html.duckduckgo.com/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Web Video Subtitle"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.miruro.to/*",
        "https://reanime.to/*",
        "https://*.reanime.cz/*",
        "https://flixcloud.cc/*",
        "https://strm.cx/*"
      ],
      "js": [
        "pageBridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*.miruro.to/*",
        "https://reanime.to/*",
        "https://*.reanime.cz/*",
        "https://flixcloud.cc/*",
        "https://strm.cx/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
