{
  "manifest_version": 3,
  "name": "Anime Korean Subtitle",
  "description": "Miruro / Re:ANIME 외부 자막 검색 및 텍스트 기반 한국어 번역",
  "version": "0.5.2",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "https://*.miruro.to/*",
    "https://reanime.to/*",
    "https://api.anissia.net/*",
    "https://graphql.anilist.co/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://jimaku.cc/*",
    "https://subtitles.ajatt.top/*",
    "https://raw.githubusercontent.com/Ajatt-Tools/kitsunekko-mirror/*",
    "https://generativelanguage.googleapis.com/*",
    "https://miruro.to/*",
    "https://www.miruro.to/*",
    "https://flixcloud.cc/*",
    "https://strm.cx/*",
    "https://*.blogspot.com/*",
    "https://*.tistory.com/*",
    "https://blog.kakaocdn.net/*",
    "https://drive.google.com/*",
    "https://drive.usercontent.google.com/*",
    "https://api.github.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "한국어 자막"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.miruro.to/*",
        "https://reanime.to/*",
        "https://flixcloud.cc/*",
        "https://strm.cx/*"
      ],
      "js": [
        "pageBridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://*.miruro.to/*",
        "https://reanime.to/*",
        "https://flixcloud.cc/*",
        "https://strm.cx/*"
      ],
      "js": [
        "contentScript.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
